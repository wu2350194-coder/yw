page{background:#faf2e7;color:#584944;font-family:system-ui,sans-serif;font-size:28rpx}.page{padding:30rpx;background:radial-gradient(ellipse at top right,#f1d7df,transparent 65%);min-height:100vh;box-sizing:border-box}.card{background:#fffcf6;border:1rpx solid #ebdcd4;border-radius:32rpx;padding:30rpx;margin-bottom:26rpx;box-shadow:0 10rpx 25rpx #9868780a}.title{font-size:42rpx;margin:18rpx 0}.muted{color:#978378;font-size:25rpx;line-height:1.8}.row{display:flex;gap:16rpx;margin:24rpx 0;flex-wrap:wrap}button{border-radius:28rpx;font-size:27rpx;margin:12rpx 0}button[type=primary]{background:#aa6d7d;color:white}input,textarea{background:#f8efe8;border:1rpx solid #e4d1c8;border-radius:20rpx;padding:22rpx;box-sizing:border-box;width:100%;margin:20rpx 0}textarea{height:250rpx}.error{color:#a54e60;white-space:pre-wrap;margin-top:20rpx}.photo{width:100%;border-radius:22rpx}.tabs{white-space:nowrap;margin-bottom:24rpx}.tab{display:inline-block;padding:16rpx 24rpx;border-radius:30rpx;margin-right:10rpx;background:#f0e0dc}.active{background:#ad7280;color:white}.note{white-space:pre-wrap;line-height:1.9}.tiny{font-size:23rpx}.map{height:440rpx;width:100%;border-radius:28rpx;overflow:hidden}.day{font-size:86rpx;color:#ad7280}.petals{font-size:60rpx;color:#bb8f9a;animation:float 5s ease-in-out infinite}@keyframes float{50%{transform:translateY(-12rpx)}}