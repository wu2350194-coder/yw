<view class="page"><scroll-view scroll-x class="tabs"><view wx:for="{{tabs}}" wx:key="*this" class="tab {{tab===item?'active':''}}" data-tab="{{item}}" bindtap="switchTab">{{item}}</view></scroll-view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="refresh">重试同步</button></view>
<view wx:if="{{tab==='首页'}}"><view class="card"><view class="petals">✿ ♡ ✿</view><view class="title">我们的日常</view><view class="day">1000</view><view class="muted">本期纪念 · 火花 1000 天</view><view class="note">日子慢慢过，故事慢慢写。</view></view><view class="card"><view class="title">写给你的信</view><view class="note">谢谢你，让屏幕里的小火花，有了生活里的温度。以后的日子，也想继续和你分享。</view><view class="muted">纪念文案草稿，可继续编辑</view></view><button bindtap="logout">退出登录</button></view>
<view wx:if="{{tab==='相册'}}"><scroll-view scroll-x class="tabs"><view wx:for="{{categories}}" wx:key="*this" class="tab {{category===item?'active':''}}" data-category="{{item}}" bindtap="filter">{{item}}</view></scroll-view><view class="card" wx:for="{{photos}}" wx:key="id"><view class="muted">{{item.category}}</view><image wx:if="{{images[item.id]}}" class="photo" mode="widthFix" src="{{images[item.id]}}" data-id="{{item.id}}" bindtap="preview"/><button wx:else data-id="{{item.id}}" bindtap="loadPhoto">轻触打开照片</button><view>{{item.title}}</view><view class="muted">{{item.note}}</view></view></view>
<view wx:if="{{tab==='日记'}}"><view class="card"><input placeholder="标题" value="{{draft.title}}" data-field="title" bindinput="draftInput"/><picker mode="date" value="{{draft.date}}" bindchange="dateChange"><view>日期：{{draft.date}}</view></picker><picker range="{{moods}}" bindchange="moodChange"><view>心情：{{draft.mood}}</view></picker><textarea placeholder="写下今天的故事…" maxlength="20000" value="{{draft.body}}" data-field="body" bindinput="draftInput"/><button type="primary" bindtap="saveDiary" disabled="{{busy}}" loading="{{busy}}">保存并同步</button><button wx:if="{{draft.id}}" bindtap="newDiary">取消编辑</button></view><view class="card" wx:for="{{entries}}" wx:key="id"><view class="muted">{{item.date}} · {{item.author==='him'?'男方':'女方'}} · {{item.mood}}</view><view class="title">{{item.title}}</view><view class="note">{{item.body}}</view><button wx:if="{{item.author===role}}" data-id="{{item.id}}" bindtap="editDiary">编辑</button></view></view>
<view wx:if="{{tab==='互动'}}"><view class="row"><button data-mode="quiz" bindtap="modeChange">默契问答</button><button data-mode="notes" bindtap="modeChange">心里话</button><button data-mode="date" bindtap="modeChange">约会抽签</button></view><view class="card" wx:if="{{room}}"><view class="muted">第 {{room.round+1}} 轮 · 每 3 秒同步</view><block wx:if="{{mode==='date'}}"><view class="plan">{{plan||'一起抽一个小计划'}}</view><button type="primary" data-action="next" bindtap="action" disabled="{{busy}}">一起抽签</button></block><block wx:else><view class="title">{{mode==='quiz'?question.q:'有一句话想给你'}}</view><view class="muted">男方：{{room.submitted.him?'已提交':'等待'}} · 女方：{{room.submitted.her?'已提交':'等待'}}</view><block wx:if="{{room.answers}}"><view class="note">男方：{{answerHim}}</view><view class="note">女方：{{answerHer}}</view><button data-action="next" bindtap="action" disabled="{{busy}}">下一轮</button></block><view wx:elif="{{submitted}}">你的答案已藏好，等对方提交。</view><block wx:elif="{{mode==='quiz'}}"><button wx:for="{{question.a}}" wx:key="*this" data-action="answer" data-answer="{{index}}" bindtap="action" disabled="{{busy}}">{{item}}</button></block><block wx:else><textarea value="{{note}}" bindinput="noteInput" maxlength="1000" placeholder="想对你说……"/><button data-action="answer" bindtap="action" disabled="{{busy}}">藏好心意</button></block></block></view></view>
<view wx:if="{{tab==='旅行'}}" class="card"><view class="title">一起走过的地方</view><map class="map" latitude="29.87" longitude="120.4" scale="9" markers="{{markers}}"/><view class="note">♡ 诸暨　♡ 绍兴</view><view class="muted">目前只记录这两处足迹。</view></view>
<view wx:if="{{tab==='视频'}}"><view class="card" wx:for="{{clips}}" wx:key="id"><video wx:if="{{item.src}}" src="{{item.src}}" controls style="width:100%" id="clip{{item.id}}" bindplay="videoPlay" data-id="{{item.id}}"/><button wx:else data-id="{{item.id}}" bindtap="loadVideo">加载回忆片段 {{item.id}}</button></view></view></view>