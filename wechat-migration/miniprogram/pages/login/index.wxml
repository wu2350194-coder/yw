<view class="page"><view class="card login"><text class="heart">♡</text><view class="title">我们的日常</view><view class="muted">把喜欢，写进每一天。</view><view class="row"><button data-role="him" bindtap="choose" type="{{role==='him'?'primary':'default'}}">男方</button><button data-role="her" bindtap="choose" type="{{role==='her'?'primary':'default'}}">女方</button></view><input password value="{{password}}" bindinput="input" placeholder="输入你们的密码"/><button type="primary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">打开我们的手账</button><view class="error">{{error}}</view></view></view>